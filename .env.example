DATABASE_ACCESS_MODE=self-hosted-postgres
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
AUTH_SESSION_SECRET=<long-random-session-secret>

# Production startup gate. Set to true only after applying database-schema.sql
# and preserving the successful output of scripts/verify-security-schema.sql.
SECURITY_SCHEMA_VERIFIED=false

# Optional Supabase cloud mode. Production server-side DB access requires service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional first admin bootstrap. In production, use a strong password and remove after bootstrap.
INITIAL_ADMIN_ACCOUNT=
INITIAL_ADMIN_PASSWORD=

# File storage
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./public/uploads
LOCAL_PUBLIC_BASE_PATH=/uploads
LOCAL_PROTECTED_BASE_PATH=/api/materials/file
LOCAL_UPLOAD_PUBLIC_ACCESS=public
LOCAL_UPLOAD_PUBLIC_ACCESS_ACCEPTED=
LOCAL_MEDIA_SIGNING_SECRET=
PUBLIC_MEDIA_BASE_URL=http://<host>:5000

# S3 compatible storage, used only when STORAGE_DRIVER=s3
S3_ENDPOINT=http://<s3-host>:<port>
S3_REGION=<region>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY=<access-key>
S3_SECRET_KEY=<secret-key>

# AI configuration can also be managed in the app settings.
# Keep real values in .env.local or the database, never in Git.
AI_CONFIG_ENCRYPTION_KEY=<long-random-ai-config-key>
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional AI endpoint allowlist. Leave empty to allow intranet/local/public AI endpoints.
# Set it only when you want to restrict AI calls to specific hosts.
AI_ALLOWED_HOSTS=
# Deployment label for documentation/ops. It does not block intranet AI endpoints by itself.
DEPLOYMENT_NETWORK=intranet
AI_ALLOW_PRIVATE_ENDPOINTS=true

# Optional comma-separated allowlist for next/image remote hosts.
# Local uploads under public/uploads do not need this.
NEXT_IMAGE_REMOTE_HOSTS=

PORT=5000
NODE_ENV=development
